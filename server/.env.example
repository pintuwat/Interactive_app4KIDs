# Copy to .env for local use. On Coolify, set these as environment variables on the API application (never commit real values).
NODE_ENV=production
PORT=3000

# Internal connection URL of the Coolify PostgreSQL resource (not exposed to the internet)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Long random string, at least 32 characters:  openssl rand -base64 48
JWT_SECRET=

# The website origin(s) allowed to call the API (comma separated, https only in production)
CORS_ORIGIN=https://phonics.example.com

# Optional: only people who know this code can register as a teacher. Leave empty to allow open registration.
REGISTRATION_CODE=
# Set to false to close registration once your teachers have accounts
ALLOW_REGISTRATION=true

# Number of reverse proxies in front of the API (Coolify's proxy = 1)
TRUST_PROXY=1
# Optional tuning
# TEACHER_TOKEN_HOURS=8
# STUDENT_TOKEN_DAYS=90
# MAX_STUDENTS_PER_CLASS=60
